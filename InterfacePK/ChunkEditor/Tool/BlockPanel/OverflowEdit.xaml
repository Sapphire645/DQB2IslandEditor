<UserControl x:Class="DQB2IslandEditor.InterfacePK.ChunkEditor.Tool.BlockPanel.OverflowEdit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DQB2IslandEditor.InterfacePK.ChunkEditor.Tool.BlockPanel"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="800" Loaded="OnLoad">
    <Viewbox>
        <Grid>
            <Border Background="Black" BorderBrush="LightBlue" BorderThickness="1.5" CornerRadius="5" Padding="8" Margin="0,12,0,0" MinWidth="550">
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Builder Placed:" Foreground="White" FontSize="14" TextWrapping="WrapWithOverflow" FontWeight="DemiBold"/>
                    <TextBlock Text="{Binding BuilderPlaced}" Foreground="White" FontSize="14" Margin="10,0" Width="100" TextWrapping="WrapWithOverflow" HorizontalAlignment="Center"/>
                    <CheckBox IsChecked="{Binding BuilderPlaced}"/>
                </StackPanel>
            </Border>
            <Border Background="Black" BorderBrush="LightBlue" BorderThickness="1.5" CornerRadius="8" Margin="4,0" Padding="12,4" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24">
                    <TextBlock Text="Block Values" Foreground="White" Margin="8,-2,8,0" FontWeight="SemiBold"  FontSize="12">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="0" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Border>
        </Grid>
    </Viewbox>
</UserControl>
