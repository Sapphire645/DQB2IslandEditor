<UserControl x:Class="DQB2IslandEditor.ObjectPK.Container.Submenus.AirPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DQB2IslandEditor.ObjectPK.Container.Submenus"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                            Background="Transparent" 
                            BorderBrush="White" 
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="5"
                            Visibility="{TemplateBinding Visibility}"
                            >
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="Orange"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="Orange"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="Gold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="#232337" BorderThickness="2" CornerRadius="5" Padding="20,10" Width="400">
        <UniformGrid Rows="1" Columns="11" MinHeight="15">
            <Button Tag="20" PreviewMouseLeftButtonDown="SelectedItem" PreviewMouseRightButtonDown="SelectedRightItem">
            </Button>
            <Button Tag="0" PreviewMouseLeftButtonDown="SelectedItem" PreviewMouseRightButtonDown="SelectedRightItem">
                <Image Source="/Images/Inventory/shellIcon/00.png"/>
            </Button>
            <Button Tag="1" PreviewMouseLeftButtonDown="SelectedItem" PreviewMouseRightButtonDown="SelectedRightItem">
                <Image Source="/Images/Inventory/shellIcon/01.png"/>
            </Button>
            <Button Tag="2" PreviewMouseLeftButtonDown="SelectedItem" PreviewMouseRightButtonDown="SelectedRightItem">
                <Image Source="/Images/Inventory/shellIcon/02.png"/>
            </Button>
            <Button Tag="3" PreviewMouseLeftButtonDown="SelectedItem" PreviewMouseRightButtonDown="SelectedRightItem">
                <Image Source="/Images/Inventory/shellIcon/03.png"/>
            </Button>
            <Button Tag="4" PreviewMouseLeftButtonDown="SelectedItem" PreviewMouseRightButtonDown="SelectedRightItem">
                <Image Source="/Images/Inventory/shellIcon/04.png"/>
            </Button>
            <Button Tag="5" PreviewMouseLeftButtonDown="SelectedItem" PreviewMouseRightButtonDown="SelectedRightItem">
                <Image Source="/Images/Inventory/shellIcon/05.png"/>
            </Button>
            <Button Tag="6" PreviewMouseLeftButtonDown="SelectedItem" PreviewMouseRightButtonDown="SelectedRightItem">
                <Image Source="/Images/Inventory/shellIcon/06.png"/>
            </Button>
            <Button Tag="7" PreviewMouseLeftButtonDown="SelectedItem" PreviewMouseRightButtonDown="SelectedRightItem">
                <Image Source="/Images/Inventory/shellIcon/07.png"/>
            </Button>
            <Button Tag="8" PreviewMouseLeftButtonDown="SelectedItem" PreviewMouseRightButtonDown="SelectedRightItem">
                <Image Source="/Images/Inventory/shellIcon/08.png"/>
            </Button>
            <Button Tag="9" PreviewMouseLeftButtonDown="SelectedItem" PreviewMouseRightButtonDown="SelectedRightItem">
                <Image Source="/Images/Inventory/shellIcon/09.png"/>
            </Button>
        </UniformGrid>
    </Border>
</UserControl>
