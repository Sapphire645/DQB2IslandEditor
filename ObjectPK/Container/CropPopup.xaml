<UserControl x:Class="DQB2IslandEditor.ObjectPK.Container.CropPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DQB2IslandEditor.ObjectPK.Container"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="WaterButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border" Background="Transparent" BorderBrush="LightGray" BorderThickness="2" CornerRadius="4" Padding="2,2">
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#50FFFFFF" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="Orange" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#50FFAA00" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="Gold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="Black" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="Gray" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="#232337" BorderThickness="2" CornerRadius="5" Padding="20,10" Width="400">
        <Grid Margin="5">
            <Image Source="/Images/Inventory/CropMenu.png"/>
            <UniformGrid Name="grid" Rows="1" Columns="7">
                <Button Tag="0"  PreviewMouseLeftButtonDown="SelectedItem" PreviewMouseRightButtonDown="SelectedRightItem" Style="{StaticResource WaterButtonStyle}">
                    <Button.ToolTip>
                        <ToolTip Background="Transparent" BorderThickness="0">
                            <local:InventoryInfo objectInfoPanel="{Binding Path=objects[0]}"/>
                        </ToolTip>
                    </Button.ToolTip>
                </Button>
                <Button Tag="1"  PreviewMouseLeftButtonDown="SelectedItem" PreviewMouseRightButtonDown="SelectedRightItem" Style="{StaticResource WaterButtonStyle}">
                    <Button.ToolTip>
                        <ToolTip Background="Transparent" BorderThickness="0">
                            <local:InventoryInfo objectInfoPanel="{Binding Path=objects[1]}"/>
                        </ToolTip>
                    </Button.ToolTip>
                </Button>
                <Button Tag="2" PreviewMouseLeftButtonDown="SelectedItem" PreviewMouseRightButtonDown="SelectedRightItem" Style="{StaticResource WaterButtonStyle}">
                    <Button.ToolTip>
                        <ToolTip Background="Transparent" BorderThickness="0">
                            <local:InventoryInfo objectInfoPanel="{Binding Path=objects[2]}"/>
                        </ToolTip>
                    </Button.ToolTip>
                </Button>
                <Button Tag="3" PreviewMouseLeftButtonDown="SelectedItem" PreviewMouseRightButtonDown="SelectedRightItem" Style="{StaticResource WaterButtonStyle}">
                    <Button.ToolTip>
                        <ToolTip Background="Transparent" BorderThickness="0">
                            <local:InventoryInfo objectInfoPanel="{Binding Path=objects[3]}"/>
                        </ToolTip>
                    </Button.ToolTip>
                </Button>
                <Button Tag="4"  PreviewMouseLeftButtonDown="SelectedItem" PreviewMouseRightButtonDown="SelectedRightItem" Style="{StaticResource WaterButtonStyle}">
                    <Button.ToolTip>
                        <ToolTip Background="Transparent" BorderThickness="0">
                            <local:InventoryInfo objectInfoPanel="{Binding Path=objects[4]}"/>
                        </ToolTip>
                    </Button.ToolTip>
                </Button>
                <Button Tag="5"  PreviewMouseLeftButtonDown="SelectedItem" PreviewMouseRightButtonDown="SelectedRightItem" Style="{StaticResource WaterButtonStyle}">
                    <Button.ToolTip>
                        <ToolTip Background="Transparent" BorderThickness="0">
                            <local:InventoryInfo objectInfoPanel="{Binding Path=objects[5]}"/>
                        </ToolTip>
                    </Button.ToolTip>
                </Button>
                <Button Tag="6" PreviewMouseLeftButtonDown="SelectedItem" PreviewMouseRightButtonDown="SelectedRightItem" Style="{StaticResource WaterButtonStyle}">
                    <Button.ToolTip>
                        <ToolTip Background="Transparent" BorderThickness="0">
                            <local:InventoryInfo objectInfoPanel="{Binding Path=objects[6]}"/>
                        </ToolTip>
                    </Button.ToolTip>
                </Button>
            </UniformGrid>
        </Grid>
    </Border>
</UserControl>
